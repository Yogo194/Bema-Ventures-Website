# Local: copy to `.env` and fill in the key.
#   cp .env.example .env
#
# Production: do NOT commit `.env`. Set this same variable in your host's
# dashboard (Vercel / Netlify / Cloudflare / CI) so it is available when
# `npm run build` runs. Vite bakes VITE_* values in at build time.
#
# Get a free access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=
